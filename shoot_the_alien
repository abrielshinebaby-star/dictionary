import pgzrun,random

WIDTH=600
HEIGHT=600
TITLE= "Shoot the Alien👽"


alien=Actor("alien foto")
alien.x=300
alien.y=550

def draw():
    screen.fill("black")
    alien.draw()
    screen.draw.text("you hit the alien",(300,0))

def on_mouse_down(pos):
    if alien.collidepoint(pos):
        alien.x=random.randint(50,550)
        alien.y=random.randint(50,550)
    

def update():
    pass
pgzrun.go()